{
  "name": "flowplan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:boundaries:v2": "node scripts/v2/boundaries.mjs",
    "typecheck:v2": "node scripts/v2/boundaries.mjs && tsc -p tsconfig.v2.app.json --noEmit",
    "build:v2": "node scripts/v2/build.mjs",
    "test:v2": "node scripts/v2/test.mjs",
    "dev:v2": "node scripts/v2/dev.mjs",
    "test:browser:v2": "npm run build:v2 && node scripts/v2/browser-isolation-test.mjs",
    "test:portable:v2": "node --test scripts/v2/servers.test.cjs",
    "build:sea:v2": "node scripts/v2/build-sea.mjs",
    "test:sea:v2": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/v2/smoke-sea.ps1",
    "smoke:v2": "node scripts/v2/smoke.mjs",
    "dev": "npm run dev:v2",
    "build": "npm run build:v2",
    "typecheck": "npm run typecheck:v2",
    "test": "npm run test:v2",
    "build:sea": "npm run build:sea:v2",
    "test:portable": "npm run test:portable:v2",
    "test:sea": "npm run test:sea:v2",
    "test:storage": "npm run test:browser:v2"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "5.9.3"
  }
}
